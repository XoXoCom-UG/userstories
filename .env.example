# Where each XoXoCom product lives, for the app launcher (the nine dots).
# Empty = "Soon". Full http(s) address, nothing else.
NEXT_PUBLIC_APP_URL_AGENTIX=
NEXT_PUBLIC_APP_URL_ARCHITECT=
NEXT_PUBLIC_APP_URL_STORIES=
NEXT_PUBLIC_APP_URL_COACH=

# The shared XoXoCom account: the SAME Supabase project as AgentiX (one account
# for every product). Public values only — never the service-role key in this app.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Cloudflare Turnstile site key for THIS app's domain. Set it before CAPTCHA is
# switched on in Supabase, or nobody can sign in.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# SERVER ONLY — never with a NEXT_PUBLIC_ prefix, and in Vercel for Production only
# (a Preview deployment runs whatever branch was pushed). Used for one thing:
# redeeming a beta key (app/api/beta/redeem). Without it, development lets the
# request through and production refuses it.
SUPABASE_SERVICE_ROLE_KEY=
# Optional salt for the hashed network address in the rate limit; defaults to the
# service-role key.
IP_HASH_SALT=
